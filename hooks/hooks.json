{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python \"${CLAUDE_PLUGIN_ROOT}/scripts/governor.py\"",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Read|NotebookRead|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python \"${CLAUDE_PLUGIN_ROOT}/scripts/safety.py\"",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python \"${CLAUDE_PLUGIN_ROOT}/scripts/gates.py\"",
            "timeout": 300,
            "_note": "Above gates.TEST_TIMEOUT (240s). If the two matched, this hook could be killed before the script returned its timeout denial — and a gate that dies lets the commit through."
          }
        ]
      }
    ]
  }
}
